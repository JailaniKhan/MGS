APP_NAME=MGS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kabul
APP_URL=http://localhost

DB_CONNECTION=sqlite

WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
ANTHROPIC_API_KEY=
# TypeSafe (Jev) — reminder tone judgment layer (optional)
TYPESAFE_API_KEY=

# Google OAuth (social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost/api/auth/google/callback

NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_VERSION_CODE=1
NATIVEPHP_APP_ID=com.mgs.ordermanager
NATIVEPHP_START_URL=/
NATIVEPHP_DEVELOPMENT_TEAM=
NATIVEPHP_ANDROID_MINIFY_ENABLED=true
NATIVEPHP_ANDROID_SHRINK_RESOURCES=true
NATIVEPHP_ANDROID_DEBUG_SYMBOLS=NONE
NATIVEPHP_ANDROID_MIN_SDK=26
NATIVEPHP_ANDROID_SDK_LOCATION=

# OpenWA on-device gateway (bundled into the APK)
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=
OPENWA_SESSION=default
OPENWA_AUTO_START=true